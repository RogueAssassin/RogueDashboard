TZ=Etc/UTC
RGDASH_PORT=7805
# Pin an exact release if preferred; omit this to follow :latest.
# RGDASH_IMAGE=ghcr.io/rogueassassin/rogue-dashboard:1.1.0

# Private token shared only between the web dashboard and engine agent.
# Replace this before first start. Example generator:
#   openssl rand -hex 32
CONTAINER_AGENT_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# External application network used by Rogue Dashboard to reach services.
MEDIA_NETWORK=media-net

SECURE_COOKIES=false
RGDASH_TRUST_PROXY_HEADERS=true
# Optional comma-separated host allowlist. Leave empty for LAN access by IP.
# Example: localhost,127.0.0.1,rogue-dashboard,dash.example.com
RGDASH_ALLOWED_HOSTS=

# Optional public link used when RogueRoute GPX containers are discovered.
RGDASH_ROGUEROUTE_URL=

# Service credentials remain outside the dashboard database.
RGDASH_QBITTORRENT_API_KEY=
RGDASH_QBITTORRENT_USERNAME=
RGDASH_QBITTORRENT_PASSWORD=
RGDASH_PROWLARR_KEY=
RGDASH_RADARR_KEY=
RGDASH_SONARR_KEY=
RGDASH_SEERR_KEY=
RGDASH_BAZARR_KEY=
RGDASH_TAUTULLI_KEY=
RGDASH_PIHOLE_KEY=
