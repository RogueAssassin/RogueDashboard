TZ=Australia/Melbourne
RGDASH_PORT=7805
RGDASH_IMAGE=ghcr.io/rogueassassin/roguedashboard:latest
RGDASH_RUNTIME=auto
MEDIA_NETWORK=media-net
# Must match RogueRoute GPX MEDIA_NETWORK when cross-container monitoring is enabled.

SECURE_COOKIES=false
RGDASH_TRUST_PROXY_HEADERS=true
RGDASH_ALLOWED_HOSTS=
RGDASH_ROGUEROUTE_URL=

# Optional branding/image source. Leave blank for the built-in GitHub source.
RGDASH_ASSET_BASE_URL=https://raw.githubusercontent.com/RogueAssassin/RogueDashboard/main/app/static

# Optional service integrations.
RGDASH_QBITTORRENT_API_KEY=
RGDASH_QBITTORRENT_USERNAME=
RGDASH_QBITTORRENT_PASSWORD=
RGDASH_PROWLARR_KEY=
RGDASH_RADARR_KEY=
RGDASH_SONARR_KEY=
RGDASH_SEERR_KEY=
RGDASH_BAZARR_KEY=
RGDASH_TAUTULLI_KEY=
RGDASH_PIHOLE_KEY=
