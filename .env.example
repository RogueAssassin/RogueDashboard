# ==============================================================================
# RogueDashboard Default Environment Configuration
# ==============================================================================
#
# RogueDashboard deployment directory:
#
#   /opt/media-server/roguedashboard
#
# Expected Rogue ecosystem layout:
#
#   /opt/media-server/
#   ├── roguedashboard/
#   │   ├── compose.yaml
#   │   ├── .env
#   │   ├── data/
#   │   └── custom/
#   ├── rogueforge/
#   ├── roguemediavalidator/
#   ├── rogueroute-gpx/
#   └── other Compose stacks...
#
# Copy this file to ".env" if installing manually:
#
#   cd /opt/media-server/roguedashboard
#   cp .env.example .env
#   nano .env
#
# IMPORTANT:
# - RogueDashboard's own files live in /opt/media-server/roguedashboard.
# - RogueDashboard is socket-free and never requires Docker/Podman engine access.
# - Changes to this file require the container to be recreated.
# - Do not publish a populated .env containing API keys or Discord webhooks.
# ==============================================================================


# ------------------------------------------------------------------------------
# Deployment / Container
# ------------------------------------------------------------------------------

# Host directory containing RogueDashboard's compose.yaml, .env, data and custom.
RGDASH_INSTALL_DIR=/opt/media-server/roguedashboard

# Informational: compose.yaml mounts ./data and ./custom next to itself, and update.sh keeps
# these two values in sync with the install directory. Move the install directory, not these.
# Host directory containing persistent SQLite state.
RGDASH_DATA_DIR=/opt/media-server/roguedashboard/data

# Host directory containing optional local icons and backgrounds.
RGDASH_CUSTOM_DIR=/opt/media-server/roguedashboard/custom

# Host port used to open RogueDashboard directly.
# Container port 8080 remains internal.
RGDASH_PORT=7805

# Container image to run.
# Stable production image.
RGDASH_IMAGE=ghcr.io/rogueassassin/roguedashboard:latest

# Optional pinned stable release:
# RGDASH_IMAGE=ghcr.io/rogueassassin/roguedashboard:2.0.1

# Runtime hint used for display/diagnostics only.
# Supported values: auto, podman, docker
RGDASH_RUNTIME=auto

# Existing network shared by RogueDashboard and monitored Rogue services.
MEDIA_NETWORK=media-net

# Container/application timezone.
TZ=Australia/Melbourne


# ------------------------------------------------------------------------------
# Web / Reverse Proxy
# ------------------------------------------------------------------------------

# Enable secure cookies when RogueDashboard is served publicly through HTTPS.
SECURE_COOKIES=false

# Trust forwarded headers from your controlled reverse proxy.
RGDASH_TRUST_PROXY_HEADERS=true

# Optional comma-separated allowed hosts (Host header allow-list, DNS-rebinding protection).
# Blank DISABLES host checking. When set, localhost and the container aliases are always allowed.
RGDASH_ALLOWED_HOSTS=

# Optional public RogueRoute GPX URL.
RGDASH_ROGUEROUTE_URL=

# Optional branding/image source. Leave as the canonical RogueDashboard source.
RGDASH_ASSET_BASE_URL=https://raw.githubusercontent.com/RogueAssassin/RogueDashboard/main/app/static


# ------------------------------------------------------------------------------
# Native Media Integrations
# ------------------------------------------------------------------------------

RGDASH_QBITTORRENT_API_KEY=
RGDASH_QBITTORRENT_USERNAME=
RGDASH_QBITTORRENT_PASSWORD=
RGDASH_PROWLARR_KEY=
RGDASH_RADARR_KEY=
RGDASH_SONARR_KEY=
RGDASH_SEERR_KEY=
RGDASH_BAZARR_KEY=
RGDASH_TAUTULLI_KEY=
RGDASH_PIHOLE_KEY=

# Nginx Proxy Manager bearer token.
RGDASH_NPM_TOKEN=


# ------------------------------------------------------------------------------
# Always-On Monitoring
# ------------------------------------------------------------------------------

# Seconds between server-side health checks.
RGDASH_MONITOR_INTERVAL=30

# Consecutive failed checks required before a service becomes DOWN.
RGDASH_MONITOR_FAILURE_THRESHOLD=3

# Persistent health-history retention.
# 720 hours = 30 days.
RGDASH_MONITOR_RETENTION_HOURS=720


# ------------------------------------------------------------------------------
# Discord Notifications
# ------------------------------------------------------------------------------

# Discord monitoring continues while every browser is closed.
RGDASH_DISCORD_ENABLED=false
RGDASH_DISCORD_WEBHOOK_URL=

# Incident lifecycle notifications.
RGDASH_DISCORD_NOTIFY_DOWN=true
RGDASH_DISCORD_NOTIFY_RECOVERY=true

# Optional early DEGRADED warning.
RGDASH_DISCORD_NOTIFY_DEGRADED=false

# Duplicate-event cooldown.
RGDASH_DISCORD_COOLDOWN_SECONDS=300

# Temporary delivery retry attempts.
RGDASH_DISCORD_RETRY_ATTEMPTS=3

# Suppress confirmed outages shorter than this many seconds.
RGDASH_DISCORD_MIN_OUTAGE_SECONDS=0


# ------------------------------------------------------------------------------
# Container hardening / Podman (all optional; compose.yaml has safe defaults)
# ------------------------------------------------------------------------------

# Address the published port binds to. Use 127.0.0.1 when a reverse proxy on the same host
# is the only client. Docker bypasses ufw, so 0.0.0.0 means "reachable from the whole LAN".
RGDASH_BIND=0.0.0.0

# Bind-mount options appended to the data and custom volumes. Leave EMPTY on Docker.
#   Rootless Podman:             RGDASH_DATA_MOUNT_OPTS=,U
#   Rootless Podman + SELinux:   RGDASH_DATA_MOUNT_OPTS=,U,Z   and   RGDASH_CUSTOM_MOUNT_OPTS=,Z
#   Docker + SELinux:            RGDASH_DATA_MOUNT_OPTS=,Z     and   RGDASH_CUSTOM_MOUNT_OPTS=,Z
# ",U" makes Podman give the container user ownership of ./data; never use it on custom/.
RGDASH_DATA_MOUNT_OPTS=
RGDASH_CUSTOM_MOUNT_OPTS=

# "missing" keeps recreates working offline; ./update.sh always pulls explicitly.
RGDASH_PULL_POLICY=missing

# Resource ceilings for the container.
RGDASH_MEM_LIMIT=256m
RGDASH_PIDS_LIMIT=256


# ------------------------------------------------------------------------------
# Backups and self-recovery
# ------------------------------------------------------------------------------

# Consistent SQLite backups are written to data/backups/. 0 disables the schedule.
RGDASH_BACKUP_INTERVAL_HOURS=24
RGDASH_BACKUP_KEEP=7

# If background monitoring makes no progress for this many seconds the process exits so the
# restart policy can recover it. 0 disables the watchdog.
RGDASH_WATCHDOG_SECONDS=900


# ==============================================================================
# Environment Revision Policy
# ==============================================================================
#
# .env.example is the complete default configuration for a fresh installation.
#
# Existing installations KEEP their current .env.
#
# Only releases introducing NEW environment commands receive a revision block.
# Version-only releases or features requiring no new setting do NOT add a Rev
# marker. This mirrors the RogueForge environment policy and prevents meaningless
# revision churn across the Rogue ecosystem.
#
# Example for a future release that genuinely adds a setting:
#
# ------------------------------------------------------------------------------
# Rev 200 update - RogueDashboard v2.0.0
# ------------------------------------------------------------------------------
# RGDASH_NEW_SETTING=value
#
# Upgrade tooling should append only real new commands from such a block.
# ==============================================================================

# ------------------------------------------------------------------------------
# Rev 201 update - RogueDashboard v2.0.1
# ------------------------------------------------------------------------------
# All optional - existing installations keep working without any of these:
# RGDASH_BIND=0.0.0.0
# RGDASH_DATA_MOUNT_OPTS=
# RGDASH_CUSTOM_MOUNT_OPTS=
# RGDASH_PULL_POLICY=missing
# RGDASH_MEM_LIMIT=256m
# RGDASH_PIDS_LIMIT=256
# RGDASH_BACKUP_INTERVAL_HOURS=24
# RGDASH_BACKUP_KEEP=7
# RGDASH_WATCHDOG_SECONDS=900
