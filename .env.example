TZ=Australia/Melbourne
RGDASH_PORT=7805
# Testing channel image. Change to the stable release tag after promotion to main.
RGDASH_IMAGE=ghcr.io/rogueassassin/roguedashboard:testing
# Informational runtime hint; RogueDashboard itself remains engine-neutral.
RGDASH_RUNTIME=auto
MEDIA_NETWORK=media-net
# Must match RogueRoute GPX MEDIA_NETWORK when cross-container monitoring is enabled.

SECURE_COOKIES=false
RGDASH_TRUST_PROXY_HEADERS=true
RGDASH_ALLOWED_HOSTS=
RGDASH_ROGUEROUTE_URL=

# Optional branding/image source. Leave blank for the built-in GitHub source.
RGDASH_ASSET_BASE_URL=https://raw.githubusercontent.com/RogueAssassin/RogueDashboard/main/app/static

# Optional service integrations.
RGDASH_QBITTORRENT_API_KEY=
RGDASH_QBITTORRENT_USERNAME=
RGDASH_QBITTORRENT_PASSWORD=
RGDASH_PROWLARR_KEY=
RGDASH_RADARR_KEY=
RGDASH_SONARR_KEY=
RGDASH_SEERR_KEY=
RGDASH_BAZARR_KEY=
RGDASH_TAUTULLI_KEY=
RGDASH_PIHOLE_KEY=


# Nginx Proxy Manager native widget.
# Create/copy a valid NPM bearer token and keep it server-side.
RGDASH_NPM_TOKEN=

# Always-on service monitoring.
# RogueDashboard performs these checks server-side even when no browser is open.
RGDASH_MONITOR_INTERVAL=30
RGDASH_MONITOR_FAILURE_THRESHOLD=3
RGDASH_MONITOR_RETENTION_HOURS=720

# Optional Discord webhook notifications.
# Create a Discord channel webhook and paste its HTTPS URL below.
# The webhook stays server-side and is never returned to the browser.
RGDASH_DISCORD_ENABLED=false
RGDASH_DISCORD_WEBHOOK_URL=
RGDASH_DISCORD_NOTIFY_DOWN=true
RGDASH_DISCORD_NOTIFY_RECOVERY=true
# Optional degraded warning before a service crosses the DOWN threshold.
RGDASH_DISCORD_NOTIFY_DEGRADED=false
# Prevent duplicate alerts and retry temporary Discord delivery failures.
RGDASH_DISCORD_COOLDOWN_SECONDS=300
RGDASH_DISCORD_RETRY_ATTEMPTS=3
# Set above 0 to suppress very short confirmed outages.
RGDASH_DISCORD_MIN_OUTAGE_SECONDS=0
