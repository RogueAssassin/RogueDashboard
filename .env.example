TZ=Australia/Melbourne
RGDASH_PORT=7805
RGDASH_IMAGE=ghcr.io/rogueassassin/rogue-dashboard:1.1.2
MEDIA_NETWORK=media-net

# Required shared secret between the web dashboard and restricted engine agent.
# Generate a long random value before first startup, for example:
#   openssl rand -hex 32
CONTAINER_AGENT_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

SECURE_COOKIES=false
RGDASH_TRUST_PROXY_HEADERS=true
RGDASH_ALLOWED_HOSTS=
RGDASH_ROGUEROUTE_URL=

# Service integrations.
RGDASH_QBITTORRENT_API_KEY=
RGDASH_QBITTORRENT_USERNAME=
RGDASH_QBITTORRENT_PASSWORD=
RGDASH_PROWLARR_KEY=
RGDASH_RADARR_KEY=
RGDASH_SONARR_KEY=
RGDASH_SEERR_KEY=
RGDASH_BAZARR_KEY=
RGDASH_TAUTULLI_KEY=
RGDASH_PIHOLE_KEY=
